#!/usr/bin/env python3
"""Generate VM flow policies from capture-level CSV summaries."""

import argparse
from pathlib import Path
import sys

ROOT = Path(__file__).resolve().parent
sys.path.insert(0, str(ROOT / "src"))

from flowshift.calibration import generate  # noqa: E402


def main() -> None:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--csv-root", type=Path, default=ROOT.parent / "dataset" / "CSV")
    parser.add_argument("--environment", choices=("VPN", "Non VPN"), default="VPN")
    parser.add_argument("--link-bps", type=int, default=250_000_000)
    parser.add_argument("--calibration-seed", type=int, default=42)
    parser.add_argument("--output-dir", type=Path, default=ROOT / "configs")
    args = parser.parse_args()
    if args.link_bps <= 0:
        parser.error("--link-bps must be positive")
    paths = generate(args.csv_root, args.environment, args.link_bps,
                     args.calibration_seed, ROOT / "configs", args.output_dir)
    for path in paths:
        print(f"{path}: derived")


if __name__ == "__main__":
    main()
